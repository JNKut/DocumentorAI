OPENAI_API_KEY=your_openai_api_key_here
DATABASE_URL=your_neon_postgresql_url_here
# Use a long random value, e.g. `openssl rand -base64 32`
ADMIN_PASSWORD=choose_a_strong_password_here
NODE_ENV=development
# Optional
SENTRY_DSN=
# Chat model; must have a price entry in server/storage.ts (default gpt-4o-mini)
OPENAI_CHAT_MODEL=gpt-4o-mini
# Chat replies pause for the day once this much OpenAI spend is reached (default 1; use 2 for Pro clients)
DAILY_OPENAI_BUDGET_USD=1
